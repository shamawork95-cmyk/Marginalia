{
  "name": "marginalia",
  "private": true,
  "version": "2.9.0",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Shama Iqbal Hussain",
    "email": "marginaliaannotator@gmail.com"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "test": "tsc --noEmit && tsx --test \"*.test.ts\" \"src/**/*.test.ts\" \"electron/**/*.test.ts\"",
    "desktop": "npm run build && electron .",
    "guide:capture": "npm run build && electron scripts/capture-guide.cjs",
    "test:e2e": "npm run build && electron scripts/e2e-marking.cjs && electron scripts/e2e-views.cjs && electron scripts/e2e-blackout.cjs && node scripts/e2e-first-run.cjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:publish": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "epubjs": "^0.3.93",
    "express": "^4.22.3",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.1",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "^0.9.12"
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "productName": "Marginalia",
  "description": "A mindful document reader with an annotating PDF workspace and on-demand AI thematic analysis. Everything stays on your machine.",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.marginalia.app",
    "productName": "Marginalia",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.*",
      "!node_modules/vite/**/*",
      "!**/*.map"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    }
  }
}
